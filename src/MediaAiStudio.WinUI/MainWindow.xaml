<Window
    x:Class="MediaAiStudio.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Media AI Studio">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Media AI Studio" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Native WinUI3 shell connected to a Python AI worker over stdio JSON-RPC." />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Content="Initialize worker" Click="InitializeWorker_Click" />
            <Button Content="Run sample task" Click="RunSampleTask_Click" />
            <Button Content="Cancel task" Click="CancelTask_Click" />
            <Button Content="Shutdown" Click="Shutdown_Click" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="8">
                <TextBlock Text="Status" FontSize="18" FontWeight="SemiBold" />
                <ProgressBar x:Name="TaskProgress" Minimum="0" Maximum="100" Height="8" />
                <TextBlock x:Name="StatusText" Text="Worker is not initialized." TextWrapping="Wrap" />
                <TextBlock x:Name="ResultText" TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Column="1" BorderBrush="#66808080" BorderThickness="1" Padding="12">
                <ScrollViewer>
                    <TextBlock x:Name="LogText" FontFamily="Consolas" TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
