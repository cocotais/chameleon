<Window
    x:Class="Chameleon.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Chameleon">

    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        AllowDrop="True"
        DragOver="RootGrid_DragOver"
        Drop="RootGrid_Drop"
        Opacity="0"
        RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScaleTransform" ScaleX="0.985" ScaleY="0.985" />
        </Grid.RenderTransform>

        <Grid.Resources>
            <SolidColorBrush x:Key="PaneFillBrush" Color="{ThemeResource LayerOnMicaBaseAltFillColorDefault}" />
            <SolidColorBrush x:Key="CardFillBrush" Color="{ThemeResource CardBackgroundFillColorDefault}" />
            <SolidColorBrush x:Key="CardStrokeBrush" Color="{ThemeResource CardStrokeColorDefault}" />
            <SolidColorBrush x:Key="SubtleFillBrush" Color="{ThemeResource SubtleFillColorSecondary}" />

            <Style x:Key="BodyTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="TextTrimming" Value="None" />
            </Style>

            <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="TextTrimming" Value="None" />
            </Style>

            <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="{StaticResource CardFillBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Padding="16,0,140,0" Background="{StaticResource PaneFillBrush}" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Image Width="24" Height="24" VerticalAlignment="Center" Source="Assets/Square44x44Logo.png" />
            <TextBlock Grid.Column="1" Text="Chameleon" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="Media Converter" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
        </Grid>

        <Grid x:Name="ShellGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PaneColumn" Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PaneFillBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="PaneContent" Padding="20,16,16,20" RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="260" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Conversion" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="Choose the target format and preset. The worker starts automatically." Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>

                        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Target format" Style="{StaticResource SectionLabelStyle}" />
                                    <ComboBox x:Name="TargetFormatBox" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="TargetFormatBox_SelectionChanged">
                                        <ComboBoxItem Content="Auto" />
                                        <ComboBoxItem Content="mp4" />
                                        <ComboBoxItem Content="mp3" />
                                        <ComboBoxItem Content="wav" />
                                        <ComboBoxItem Content="flac" />
                                        <ComboBoxItem Content="m4a" />
                                        <ComboBoxItem Content="webm" />
                                        <ComboBoxItem Content="mkv" />
                                        <ComboBoxItem Content="jpg" />
                                        <ComboBoxItem Content="png" />
                                        <ComboBoxItem Content="webp" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Preset" Style="{StaticResource SectionLabelStyle}" />
                                    <ComboBox x:Name="PresetBox" HorizontalAlignment="Stretch" SelectedIndex="1">
                                        <ComboBoxItem Content="high" />
                                        <ComboBoxItem Content="balanced" />
                                        <ComboBoxItem Content="small" />
                                        <ComboBoxItem Content="remux" />
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="18">
                            <Grid RowSpacing="14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                    <FontIcon Glyph="&#xE8E5;" FontSize="32" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <TextBlock Text="Drop media files" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="Or use the Add button." Style="{StaticResource SecondaryTextStyle}" TextAlignment="Center" HorizontalAlignment="Center" />
                                </StackPanel>

                                <Button Grid.Row="1" HorizontalAlignment="Stretch" Click="AddFiles_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8E5;" FontSize="15" />
                                        <TextBlock Text="Add files" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="3" Spacing="10">
                            <TextBlock Text="Output folder" Style="{StaticResource SectionLabelStyle}" />
                            <Border Background="{StaticResource SubtleFillBrush}" CornerRadius="6" Padding="11">
                                <Grid ColumnSpacing="9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE838;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="OutputFolderText" Grid.Column="1" Text="Source folder / Converted" TextTrimming="CharacterEllipsis" Style="{StaticResource BodyTextStyle}" />
                                </Grid>
                            </Border>
                            <Button HorizontalAlignment="Stretch" Click="ChooseOutputFolder_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="15" />
                                    <TextBlock Text="Choose output folder" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>

            <Grid x:Name="ContentShell" Grid.Column="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <Border x:Name="ContentCornerMask" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{StaticResource PaneFillBrush}" />
                <Border Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" CornerRadius="12,0,0,0" />
                <Grid x:Name="ContentPage" Padding="24,18,24,20" RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="2">
                        <TextBlock Text="Queue" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="Files are probed first, then converted in order." Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>

                    <CommandBar Grid.Column="1" DefaultLabelPosition="Right" Background="Transparent" IsOpen="False">
                        <AppBarButton Icon="Add" Label="Add" Click="AddFiles_Click" />
                        <AppBarButton Icon="Folder" Label="Output" Click="ChooseOutputFolder_Click" />
                        <AppBarButton Icon="Play" Label="Start" Click="StartQueue_Click" />
                        <AppBarButton Icon="Cancel" Label="Cancel" Click="CancelTask_Click" />
                        <CommandBar.SecondaryCommands>
                            <AppBarButton Icon="Message" Label="Activity log" Click="ShowLog_Click" />
                        </CommandBar.SecondaryCommands>
                    </CommandBar>
                </Grid>

                <Border x:Name="QueueCard" Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="1">
                    <Grid Background="Transparent">
                        <ListView x:Name="JobsList" SelectionMode="Single" Padding="6" Background="Transparent">
                            <ListView.Header>
                                <Grid Padding="12,10" ColumnSpacing="10" BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="0,0,0,1" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition x:Name="SourceColumn" Width="72" />
                                        <ColumnDefinition x:Name="TargetColumn" Width="72" />
                                        <ColumnDefinition x:Name="StatusColumn" Width="96" />
                                        <ColumnDefinition x:Name="DurationColumn" Width="72" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="File" Style="{StaticResource SecondaryTextStyle}" />
                                    <TextBlock Grid.Column="1" Text="From" Style="{StaticResource SecondaryTextStyle}" />
                                    <TextBlock Grid.Column="2" Text="To" Style="{StaticResource SecondaryTextStyle}" />
                                    <TextBlock Grid.Column="3" Text="Status" Style="{StaticResource SecondaryTextStyle}" />
                                    <TextBlock Grid.Column="4" Text="Length" Style="{StaticResource SecondaryTextStyle}" />
                                </Grid>
                            </ListView.Header>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="68" Padding="10" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="72" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="5">
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Message}" Style="{StaticResource SecondaryTextStyle}" TextTrimming="CharacterEllipsis" />
                                            <ProgressBar Minimum="0" Maximum="100" Height="4" Value="{Binding Progress}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding SourceFormat}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding TargetFormat}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="4" Text="{Binding Duration}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <InfoBar x:Name="StatusInfo" IsOpen="True" Severity="Informational" Message="Ready. Drop files or click Add." />
                </Grid>

                <TeachingTip
                    x:Name="LogTip"
                    Title="Activity log"
                    PreferredPlacement="Bottom"
                    IsLightDismissEnabled="True"
                    Target="{Binding ElementName=AppTitleBar}">
                    <Border BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Background="{StaticResource CardFillBrush}" Width="560" MaxHeight="220">
                        <ScrollViewer>
                            <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="14" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                </TeachingTip>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
